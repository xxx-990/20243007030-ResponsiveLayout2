<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!--顶部 Lab 1 黑色区域-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:text="Lab 1"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="24dp"/>

    <!--包裹标题+四色块的垂直LinearLayout-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:text="Responsive Layout 1"
            android:gravity="center"
            android:padding="24dp"/>

        <!--水平方向：4个色块权重等分，width写0dp配合layout_weight="1" 【评分关键点】-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ff0000"
                android:text="This"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="20dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0000ff"
                android:text="is"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="20dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#663399"
                android:text="my"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="20dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ffff00"
                android:text="first"
                android:textColor="#000000"
                android:gravity="center"
                android:padding="20dp"/>
        </LinearLayout>
    </LinearLayout>

    <!--中间黑色大区域，占用全部剩余垂直空间 height=0dp weight=1-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:text="Android Application"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="24dp"/>

    <!--底部两个按钮 Change、Cancel-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:backgroundTint="#7b68bb"
            android:textColor="#FFFFFF"
            android:layout_marginRight="32dp"/>

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="#7b68bb"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>

